# Copy to .env and fill in. Never commit .env.

# LLM: "fake" for tests and local work, "gemini" for the real model
LLM_PROVIDER=fake
GEMINI_API_KEY=tu_key_de_gemini
GEMINI_MODEL=gemini-3.5-flash
CURSOR_API_KEY=tu_key_de_cursor
# CURSOR_MODEL=   (opcional; vacío = modelo por defecto de tu cuenta)
MINIMAX_API_KEY=tu_key_de_minimax
MINIMAX_MODEL=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Supabase PostgreSQL (Connect > Session pooler in the dashboard)
# Replace [PROJECT-REF], [REGION] and [PASSWORD]. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vhxobvlxurxgfifrvkkm.supabase.co:5432/postgres